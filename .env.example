WP_ENVIRONMENT_TYPE=development
WP_PORT=8080

DB_HOST=db:3306
DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

WP_URL=http://localhost:8080
WP_TITLE=GCA Intranet (Dev)
WP_ADMIN_USER=adminuser
WP_ADMIN_PASSWORD=change-me-strong
WP_ADMIN_EMAIL=adam.wynn@example.com
WP_THEME=gca-intranet

WP_HOME=
WP_SITEURL=

# Workday Staff API (used by the gca_sync_workday_users cron job / `wp gca sync-users`)
# OAuth 2.0 client credentials (mirrors the CCS MDM API pattern).
WORKDAY_TOKEN_ENDPOINT=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
WORKDAY_SCOPE=
# Base URL of the Azure APIM gateway (no trailing slash).
WORKDAY_API_BASE_URL=https://apim.crowncommercial.gov.uk/website-data/manual
# Resource path for the staff list endpoint.
WORKDAY_STAFF_RESOURCE=/paths/invoke/[att].[vw_WorkdayStaffListAPI]/
# Extra query string appended to the resource URL (SAS params, api-version, SearchQuery fields).
WORKDAY_STAFF_API_PARAMS=api-version=2016-10-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&SearchQuery=EmployeeKey,EmployeeName,Email,Manager,ManagerEmail,JobTitle,Team,Directorate
# Optional: Azure APIM subscription key sent as Ocp-Apim-Subscription-Key header.
WORKDAY_API_SUBSCRIPTION_KEY=

# SendGrid API key (used by WP Mail SMTP plugin via wp-config-extra.php)
SMTP_PASSWORD=your-sendgrid-api-key-here
SMTP_FROM_EMAIL=no-reply@crowncommercial.gov.uk
SMTP_FROM_NAME=GCA Intranet

# Publishing Workflow — reviewer group mailbox
# Set this in WP Admin → Settings → Publishing Workflow after first boot.
# SMTP must be configured above for emails to actually send.
GCA_REVIEWER_EMAIL=internal-comms@crowncommercial.gov.uk

# E2E test accounts for publishing workflow and permissions tests.
# Create these users in WP Admin → Users before running the Playwright suite.
WP_CONTRIBUTOR_USER=test-contributor
WP_CONTRIBUTOR_PASSWORD=
WP_PUBLISHER_USER=test-publisher
WP_PUBLISHER_PASSWORD=
WP_PUBLISHER_ADMIN_USER=test-publisher-admin
WP_PUBLISHER_ADMIN_PASSWORD=
WP_COMMUNITY_HOST_USER=test-community-host
WP_COMMUNITY_HOST_PASSWORD=

# Optional: Page ID of the homepage for the PERM-1.11 contributor restriction test.
WP_HOMEPAGE_ID=

# Optional: URL of a mail-catcher (e.g. MailHog API) for email delivery tests (WF-6.x).
# Leave blank to skip those assertions.
MAIL_CATCHER_URL=